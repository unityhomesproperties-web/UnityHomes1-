{
  "entities": {
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "An entry for the waitlist.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "The selected role."
        },
        "full_name": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "state": {
          "type": "string",
          "maxLength": 50
        },
        "information_confirmed": {
          "type": "boolean"
        },
        "role_specific_data": {
          "type": "map"
        },
        "createdAt": {
          "type": "timestamp"
        }
      },
      "required": ["role", "full_name", "email", "phone", "state", "information_confirmed", "createdAt"]
    }
  },
  "firestore": {
    "waitlist/{entryId}": {
      "schema": "WaitlistEntry",
      "description": "Waitlist signups."
    }
  }
}
