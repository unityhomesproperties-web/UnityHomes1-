{
  "entities": {
    "Building": {
      "title": "Building",
      "description": "Represents a physical building owned by a landlord and optionally managed by a PMC.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique building identifier"
        },
        "landlord_id": {
          "type": "string",
          "description": "UID or code of the owning landlord"
        },
        "management_company_id": {
          "type": "string",
          "description": "Optional PMC identifier managing this building"
        },
        "building_name": {
          "type": "string",
          "description": "Name of the building or block (e.g. Adebayo Lekki Heights)"
        },
        "building_number": {
          "type": "string",
          "description": "Building or plot number (e.g. Block 2, Plot 14)"
        },
        "address_street": {
          "type": "string",
          "description": "Street name (e.g. Admiralty Way)"
        },
        "address_area": {
          "type": "string",
          "description": "Area or neighborhood (e.g. Lekki Phase 1)"
        },
        "address_state": {
          "type": "string",
          "description": "State (e.g. Lagos)"
        },
        "cover_photo_url": {
          "type": "string",
          "description": "URL to the primary cover photo of the building"
        },
        "total_units": {
          "type": "number",
          "description": "Calculated total number of units in this building"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        },
        "is_active": {
          "type": "boolean",
          "description": "Active status flag"
        }
      },
      "required": [
        "id",
        "landlord_id",
        "building_name",
        "address_street",
        "address_state",
        "created_at"
      ]
    },
    "Unit": {
      "title": "Unit",
      "description": "Represents an individual rented space or suite inside a building.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique unit identifier"
        },
        "building_id": {
          "type": "string",
          "description": "Reference to the parent Building ID"
        },
        "landlord_id": {
          "type": "string",
          "description": "Auto-copied landlord ID from the parent building"
        },
        "management_company_id": {
          "type": "string",
          "description": "Auto-copied management company ID from the parent building"
        },
        "unit_name": {
          "type": "string",
          "description": "Name or designation of the unit (e.g. Flat A1, Suite 2B)"
        },
        "unit_type": {
          "type": "string",
          "enum": [
            "studio",
            "one bedroom",
            "two bedroom",
            "commercial",
            "three bedroom",
            "maisonette"
          ],
          "description": "Type of the unit"
        },
        "annual_rent": {
          "type": "number",
          "description": "Annual rent price in NGN"
        },
        "current_tenant_id": {
          "type": "string",
          "description": "Tenant profile ID currently occupying this unit (null if vacant)"
        },
        "occupancy_status": {
          "type": "string",
          "enum": [
            "vacant",
            "occupied",
            "reserved"
          ],
          "description": "Current occupancy status"
        },
        "collection_account_id": {
          "type": "string",
          "description": "Links to the verified bank account for rent collection"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        }
      },
      "required": [
        "id",
        "building_id",
        "landlord_id",
        "unit_name",
        "unit_type",
        "annual_rent",
        "occupancy_status",
        "created_at"
      ]
    },
    "TenantProfile": {
      "title": "Tenant Profile",
      "description": "Persistent tenant profile for a single user account across lifetime tenancies.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user/tenant profile identifier (matches user auth UID)"
        },
        "user_id": {
          "type": "string",
          "description": "User account UID"
        },
        "full_name": {
          "type": "string",
          "description": "Tenant's full legal name"
        },
        "phone": {
          "type": "string",
          "description": "Active phone number"
        },
        "email": {
          "type": "string",
          "description": "Contact email address"
        },
        "occupation": {
          "type": "string",
          "description": "Current occupation"
        },
        "employer": {
          "type": "string",
          "description": "Employer name"
        },
        "guarantor_name": {
          "type": "string",
          "description": "Guarantor full name"
        },
        "guarantor_phone": {
          "type": "string",
          "description": "Guarantor contact phone"
        },
        "guarantor_occupation": {
          "type": "string",
          "description": "Guarantor occupation"
        },
        "guarantor_address": {
          "type": "string",
          "description": "Guarantor residential or business address"
        },
        "current_tenancy_id": {
          "type": "string",
          "description": "Pointer to the active tenancy ID in tenancies collection (null if not currently renting)"
        },
        "created_at": {
          "type": "string",
          "description": "Profile creation timestamp"
        },
        "updated_at": {
          "type": "string",
          "description": "Profile last update timestamp"
        }
      },
      "required": [
        "id",
        "user_id",
        "full_name",
        "phone",
        "email"
      ]
    },
    "Tenancy": {
      "title": "Tenancy",
      "description": "Historical or active lease binding a tenant profile to a specific unit, building, landlord, and PMC.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique tenancy record identifier"
        },
        "tenant_id": {
          "type": "string",
          "description": "Tenant profile ID"
        },
        "unit_id": {
          "type": "string",
          "description": "Unit ID"
        },
        "building_id": {
          "type": "string",
          "description": "Building ID"
        },
        "landlord_id": {
          "type": "string",
          "description": "Landlord ID inherited from invitation/building"
        },
        "management_company_id": {
          "type": "string",
          "description": "PMC ID inherited from invitation/building"
        },
        "lease_start_date": {
          "type": "string",
          "description": "Lease start date (YYYY-MM-DD)"
        },
        "lease_end_date": {
          "type": "string",
          "description": "Lease end date (YYYY-MM-DD)"
        },
        "lease_amount": {
          "type": "number",
          "description": "Agreed lease rent amount"
        },
        "caution_deposit_amount": {
          "type": "number",
          "description": "Refundable caution deposit"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "ended",
            "cancelled"
          ],
          "description": "Status of tenancy"
        },
        "created_at": {
          "type": "string",
          "description": "Tenancy record creation timestamp"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "unit_id",
        "building_id",
        "landlord_id",
        "lease_start_date",
        "lease_end_date",
        "lease_amount",
        "status",
        "created_at"
      ]
    },
    "TenantInvitation": {
      "title": "Tenant Invitation",
      "description": "Pre-filled invitation generated by a landlord for a specific unit.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique invitation identifier"
        },
        "landlord_id": {
          "type": "string",
          "description": "Landlord UID creating the invitation"
        },
        "unit_id": {
          "type": "string",
          "description": "Unit ID for this invitation"
        },
        "building_id": {
          "type": "string",
          "description": "Building ID for this invitation"
        },
        "pre_filled_data": {
          "type": "object",
          "description": "JSON object with pre-filled details about the prospective tenant and lease terms"
        },
        "invitation_code": {
          "type": "string",
          "description": "Random 8-character code formatted as XXXX-XXXX (e.g. K8M4-ZP91)"
        },
        "invitation_link": {
          "type": "string",
          "description": "Full invitation URL (unityhomes.ng/join/XXXX-XXXX)"
        },
        "qr_code_url": {
          "type": "string",
          "description": "Signed URL or data URL of QR code image"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "expired"
          ],
          "description": "Invitation state"
        },
        "expires_at": {
          "type": "string",
          "description": "Expiration date exactly 14 days after creation"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "accepted_at": {
          "type": "string",
          "description": "Timestamp when invitation was accepted (null if pending/expired)"
        },
        "tenant_user_id": {
          "type": "string",
          "description": "User ID of tenant after registration (null when pending)"
        }
      },
      "required": [
        "id",
        "landlord_id",
        "unit_id",
        "building_id",
        "pre_filled_data",
        "invitation_code",
        "invitation_link",
        "status",
        "expires_at",
        "created_at"
      ]
    },
    "WaitlistEntry": {
      "title": "Waitlist Entry",
      "description": "Represents a user who has joined the waitlist.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "full_name": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 255
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "state": {
          "type": "string",
          "maxLength": 50
        },
        "role": {
          "type": "string"
        },
        "organisation_name": {
          "type": "string",
          "maxLength": 150
        },
        "interests": {
          "type": "array"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "full_name",
        "email",
        "phone",
        "state",
        "role",
        "interests",
        "status"
      ]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "Immutable log of activities.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "timestamp": {
          "type": "timestamp"
        }
      }
    },
    "BroadcastLog": {
      "title": "Broadcast Log",
      "description": "Log of broadcasted emails.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      }
    },
    "AnalyticsSnapshot": {
      "title": "Analytics Snapshot",
      "description": "Daily/hourly aggregated metrics.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "timestamp": {
          "type": "timestamp"
        }
      }
    },
    "Admin": {
      "title": "Admin",
      "description": "System administrator.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "SystemSetting": {
      "title": "System Setting",
      "description": "Global configuration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "EmailQueue": {
      "title": "Email Queue",
      "description": "Queue for sending emails.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    }
  },
  "firestore": {
    "/buildings/{buildingId}": {
      "schema": "Building",
      "description": "Stores landlord physical buildings"
    },
    "/units/{unitId}": {
      "schema": "Unit",
      "description": "Stores individual units belonging to buildings"
    },
    "/tenant_profiles/{userId}": {
      "schema": "TenantProfile",
      "description": "Stores single persistent tenant profiles"
    },
    "/tenancies/{tenancyId}": {
      "schema": "Tenancy",
      "description": "Stores current and historical tenancy agreements"
    },
    "/tenant_invitations/{invitationId}": {
      "schema": "TenantInvitation",
      "description": "Stores tenant onboarding invitations generated by landlords"
    },
    "/waitlist_entries/{entryId}": {
      "schema": "WaitlistEntry",
      "description": "Stores waitlist registrations."
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Stores immutable activity logs."
    },
    "/broadcast_logs/{broadcastId}": {
      "schema": "BroadcastLog",
      "description": "Stores email broadcast logs."
    },
    "/analytics_snapshots/{snapshotId}": {
      "schema": "AnalyticsSnapshot",
      "description": "Stores time-series analytics."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Stores administrator roles and profiles."
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSetting",
      "description": "Stores dynamic system configuration."
    },
    "/email_queue/{emailId}": {
      "schema": "EmailQueue",
      "description": "Stores emails to be dispatched by worker."
    }
  }
}