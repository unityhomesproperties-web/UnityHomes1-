rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidWaitlistEntry(data) {
      return data.keys().hasAll(["role", "full_name", "email", "phone", "state", "information_confirmed", "createdAt"]) &&
             data.role is string && data.role.size() > 0 &&
             data.full_name is string && data.full_name.size() > 0 && data.full_name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 20 &&
             data.state is string && data.state.size() > 0 && data.state.size() <= 50 &&
             data.information_confirmed is bool && data.information_confirmed == true &&
             data.createdAt == request.time;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    match /waitlist/{entryId} {
      // Anyone can create an entry as long as it is valid
      allow create: if isValidId(entryId) && isValidWaitlistEntry(request.resource.data);
      allow read, update, delete: if false;
    }
  }
}
